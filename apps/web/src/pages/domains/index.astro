---
import BaseLayout from '../../layouts/BaseLayout.astro';
import GlossaryTerm from '../../components/GlossaryTerm.astro';
import { data, gloss } from '../../lib/data';
import { withBase } from '../../lib/site';

const base = withBase();
---
<BaseLayout title="Deep dives" active="domains">
  <h2 class="sec">Domain deep dives</h2>
  <p class="muted">
    Built from whatever public protos / manifests / docs I could parse. The badge is basically “how complete does this look”.
  </p>
  <div class="dgrid" style="margin-top:16px">
    {data.domains
      .filter((d) => data.deepDives[d.id])
      .map((d) => (
        <a class="dcard" href={withBase(`domains/${d.id}/`)} data-sec={d.securityCritical ? '1' : '0'}>
          <h3>
            <GlossaryTerm term={d.title} gloss={gloss(d.title)} />
            {d.securityCritical && <span class="sflag">security</span>}
          </h3>
          <div class="p">{d.purpose}</div>
          <div class="chips">
            <span class="chip">confidence: {d.coverage.confidence}</span>
            <span class="chip">{d.coverage.hasProto ? 'proto ✓' : 'no proto'}</span>
            <span class="chip">{d.coverage.hasDocs ? 'docs ✓' : 'no docs'}</span>
          </div>
        </a>
      ))}
  </div>
</BaseLayout>
